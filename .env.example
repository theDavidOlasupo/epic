# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://alpaca:alpaca@localhost:5432/alpaca

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ── Auth (Clerk) ──────────────────────────────────────────────────────────
# Set CLERK_STUB=true to use base64-encoded JSON tokens locally
CLERK_STUB=true
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# ── Stripe ────────────────────────────────────────────────────────────────
# Set STRIPE_STUB=true to skip signature verification locally
STRIPE_STUB=true
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ── AWS (SES / SQS / S3) ─────────────────────────────────────────────────
# Set SQS_STUB=true to use in-process setTimeout instead of real SQS
SQS_STUB=true
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
SES_FROM_ADDRESS=noreply@alpacaparking.com
S3_BUCKET=alpaca-photos
SQS_LOCK_EXPIRY_QUEUE_URL=https://sqs.ca-central-1.amazonaws.com/placeholder/lock-expiry-queue
SQS_EMAIL_QUEUE_URL=https://sqs.ca-central-1.amazonaws.com/placeholder/email-queue
