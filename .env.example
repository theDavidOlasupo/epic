# ── Database ──────────────────────────────────────────────────────────────
# Local dev: use Docker Compose postgres
# Production: Railway provides this automatically as $DATABASE_URL
DATABASE_URL=postgres://alpaca:alpaca@localhost:5432/alpaca

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
# Set to your Vercel frontend URL in production
CORS_ORIGIN=http://localhost:3000

# ── Auth (Clerk) ──────────────────────────────────────────────────────────
# Local dev: set CLERK_STUB=true to use base64-encoded JSON tokens
# Production: set CLERK_STUB=false and fill in real Clerk values
# Get these from https://dashboard.clerk.com → your app → API Keys
CLERK_STUB=true
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# ── Stripe ────────────────────────────────────────────────────────────────
# Local dev: set STRIPE_STUB=true to skip webhook signature verification
# Production: set STRIPE_STUB=false and use real keys
# Get these from https://dashboard.stripe.com → Developers → API keys
STRIPE_STUB=true
STRIPE_SECRET_KEY=sk_test_placeholder
# Get webhook secret from https://dashboard.stripe.com → Webhooks
# Point webhook to: https://your-api-domain.railway.app/api/v1/payments/webhook
# Events to enable: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ── Email ─────────────────────────────────────────────────────────────────
# Options: "console" (dev), "resend" (recommended), "ses" (AWS)
EMAIL_PROVIDER=console
# Resend: get API key from https://resend.com → API Keys
RESEND_API_KEY=re_placeholder
# SES: verify your sender domain in AWS SES console
SES_FROM_ADDRESS=noreply@yourdomain.com

# ── AWS (S3 for photos) ───────────────────────────────────────────────────
# For photo uploads — use Cloudflare R2 (S3-compatible, free tier)
# or AWS S3. Set SQS_STUB=true to skip real SQS in dev.
SQS_STUB=true
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
S3_BUCKET=alpaca-photos
# Cloudflare R2 endpoint (if using R2 instead of S3):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
SQS_LOCK_EXPIRY_QUEUE_URL=https://sqs.ca-central-1.amazonaws.com/placeholder/lock-expiry-queue
SQS_EMAIL_QUEUE_URL=https://sqs.ca-central-1.amazonaws.com/placeholder/email-queue
